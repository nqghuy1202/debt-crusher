<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.debtcrusher</groupId>
    <artifactId>debt-crusher</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <modules>
        <module>debtcrusher-domain</module>
        <module>debtcrusher-infrastructure</module>
        <module>debtcrusher-application</module>
        <module>debtcrusher-controller</module>
        <module>debtcrusher-start</module>
    </modules>

    <properties>
        <maven.compiler.source>26</maven.compiler.source>
        <maven.compiler.target>26</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <jjwt.version>0.12.6</jjwt.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>4.2.0-M1</version>
                <scope>import</scope>
                <type>pom</type>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!--
        Dependency thực sự dùng chung mọi layer (domain -> infrastructure -> application -> controller -> start):
        - spring-boot-starter: mang spring-context (@Service/@Component/@EventListener/ApplicationEventPublisher)
          để domain/application dùng được mà không phải kéo theo spring-web.
        - lombok: giảm boilerplate getter/setter/builder ở mọi layer.
        - resilience4j + aop: Rate Limiter (controller, endpoint auth) cần annotation + AOP proxy này.
        - validation: Bean Validation annotation dùng cả ở application (command object) lẫn controller (request DTO).
        Còn spring-web/webmvc, mysql-connector-j, actuator, security... là dependency đặc thù theo layer,
        khai báo riêng ở từng module để tránh domain/controller kéo nhầm dependency của layer khác.
    -->
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <!-- "annotationProcessor" KHÔNG phải scope hợp lệ của Maven (đó là khái niệm của Gradle) —
                 dùng "provided" (compile-time only, không đóng gói vào jar) để maven-compiler-plugin
                 thực sự nạp Lombok làm annotation processor. -->
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-spring-boot3</artifactId>
            <version>2.1.0</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
            <!-- Không được quản lý version trong BOM 4.2.0-M1 (milestone), phải ghim thủ công như bản mẫu booking-train -->
            <version>4.0.0-M2</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.15.0</version>
                <configuration>
                    <!-- Bắt buộc để Spring đọc được tên tham số lúc runtime qua reflection (@AuthenticationPrincipal,
                         Spring Data query methods...). -->
                    <parameters>true</parameters>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>1.18.46</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <!-- *Test = unit test (surefire, chạy ở phase test, không cần DB/Docker).
                 *IT = integration test (failsafe, chạy ở phase verify) — đặt riêng vì cần
                 MySQL thật đang chạy (xem environment/docker-compose-dev.yml), không nên
                 chặn `mvn test` thường ngày của người không có Docker sẵn. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>3.5.4</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
