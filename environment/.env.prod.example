# Copy file này thành .env.prod trên VPS rồi điền giá trị THẬT (.env.prod đã bị gitignore, không commit):
#   cp .env.prod.example .env.prod
#
# Sinh giá trị random an toàn bằng: openssl rand -base64 32

DB_ROOT_PASSWORD=change-me-root-password
DB_USERNAME=debtcrusher_app
DB_PASSWORD=change-me-app-password

# Tối thiểu 256 bit (32 byte) — khớp comment trong application.yaml. Đổi khác giá trị default trong
# application.yaml, nếu không JWT ký bằng secret ai cũng đọc được trên GitHub.
JWT_SECRET=change-me-jwt-secret-min-256-bit

# Origin thật của frontend production (dùng https:// sau khi bật SSL) — không khớp thì mọi request
# từ trình duyệt bị Spring Security chặn "Invalid CORS request". Nhiều origin cách nhau bằng dấu phẩy.
APP_CORS_ALLOWED_ORIGINS=https://YOUR_DOMAIN
